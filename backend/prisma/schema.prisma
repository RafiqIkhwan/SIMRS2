datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  REGISTRATION_STAFF
  DOCTOR
  NURSE
  PHARMACIST
  LAB_STAFF
  CASHIER
  MEDICAL_RECORD_STAFF
  MANAGEMENT
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum QueueStatus {
  REGISTERED
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NoteStatus {
  DRAFT
  FINAL
  AMENDED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum AdmissionStatus {
  ADMITTED
  TRANSFERRED
  DISCHARGED
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  PROCESSING
  DISPENSED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  RETURN
  EXPIRED
}

enum LabOrderStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  VALIDATED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  BPJS
  INSURANCE
}

// -------------------------------------------------------------
// AUTH, USER & RBAC
// -------------------------------------------------------------

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@map("session")
  @@index([expire], name: "IDX_session_expire")
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique @db.VarChar(50)
  email        String        @unique @db.VarChar(100)
  passwordHash String        @db.VarChar(255)
  fullName     String        @db.VarChar(150)
  phone        String?       @db.VarChar(20)
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  roles         UserRole[]
  doctor        Doctor?
  auditLogs     AuditLog[]
  clinicalNotes ClinicalNote[]

  @@index([isActive])
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?          @db.VarChar(255)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// -------------------------------------------------------------
// MASTER UNIT & DOKTER
// -------------------------------------------------------------

model Department {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinics Clinic[]
}

model Clinic {
  id           String   @id @default(uuid())
  departmentId String
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  doctors      Doctor[]
  schedules    DoctorSchedule[]
  queues       Queue[]

  @@index([departmentId])
}

model Doctor {
  id             String   @id @default(uuid())
  userId         String   @unique
  clinicId       String
  licenseNumber  String   @unique @db.VarChar(50)
  specialization String   @db.VarChar(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic         Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  schedules      DoctorSchedule[]
  appointments   Appointment[]
  queues         Queue[]
  medicalRecords MedicalRecord[]

  @@index([clinicId])
}

model DoctorSchedule {
  id        String   @id @default(uuid())
  doctorId  String
  clinicId  String
  dayOfWeek Int
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  quota     Int      @default(30)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([doctorId, clinicId, dayOfWeek, startTime])
  @@index([doctorId, dayOfWeek])
}

// -------------------------------------------------------------
// MASTER PASIEN
// -------------------------------------------------------------

model Patient {
  id                  String         @id @default(uuid())
  medicalRecordNumber String         @unique @db.VarChar(20)
  nationalIdNumber    String         @unique @db.VarChar(20)
  fullName            String         @db.VarChar(150)
  gender              Gender
  birthDate           DateTime       @db.Date
  birthPlace          String?        @db.VarChar(100)
  bloodType           String?        @db.VarChar(5)
  maritalStatus       MaritalStatus?
  address             String         @db.Text
  city                String         @db.VarChar(100)
  phone               String         @db.VarChar(20)
  allergies           String?        @db.Text
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  emergencyContacts PatientEmergencyContact[]
  appointments      Appointment[]
  queues            Queue[]
  medicalRecords    MedicalRecord[]
  admissions        Admission[]
  invoices          Invoice[]

  @@index([fullName])
  @@index([phone])
  @@index([nationalIdNumber])
  @@index([isActive])
}

model PatientEmergencyContact {
  id           String   @id @default(uuid())
  patientId    String
  name         String   @db.VarChar(150)
  relationship String   @db.VarChar(50)
  phone        String   @db.VarChar(20)
  address      String?  @db.Text
  createdAt    DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// -------------------------------------------------------------
// PENDAFTARAN, ANTREAN & APPOINTMENT
// -------------------------------------------------------------

model Appointment {
  id             String            @id @default(uuid())
  patientId      String
  doctorId       String
  scheduledDate  DateTime          @db.Date
  status         AppointmentStatus @default(SCHEDULED)
  complaint      String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  queue   Queue?

  @@index([patientId])
  @@index([doctorId, scheduledDate])
}

model Queue {
  id            String      @id @default(uuid())
  queueDate     DateTime    @db.Date
  queueNumber   Int
  formattedCode String      @db.VarChar(20)
  clinicId      String
  doctorId      String
  patientId     String
  appointmentId String?     @unique
  status        QueueStatus @default(REGISTERED)
  calledAt      DateTime?
  servedAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor         Doctor          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  medicalRecords MedicalRecord[]

  @@unique([clinicId, queueDate, queueNumber])
  @@index([queueDate, clinicId, status])
  @@index([doctorId, queueDate])
  @@index([patientId])
}

// -------------------------------------------------------------
// REKAM MEDIS ELEKTRONIK (EMR)
// -------------------------------------------------------------

model MedicalRecord {
  id              String     @id @default(uuid())
  recordNumber    String     @unique @db.VarChar(30)
  patientId       String
  doctorId        String
  queueId         String?
  visitDate       DateTime   @default(now())
  status          NoteStatus @default(DRAFT)
  finalizedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor         Doctor          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  queue          Queue?          @relation(fields: [queueId], references: [id], onDelete: SetNull)
  clinicalNotes  ClinicalNote[]
  diagnoses      Diagnosis[]
  medicalActions MedicalAction[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  invoices       Invoice[]

  @@index([patientId, visitDate])
  @@index([doctorId])
  @@index([status])
}

model ClinicalNote {
  id              String     @id @default(uuid())
  medicalRecordId String
  authorId        String
  subjective      String     @db.Text
  objective       String     @db.Text
  assessment      String     @db.Text
  plan            String     @db.Text
  systolicBP      Int?
  diastolicBP     Int?
  heartRate       Int?
  respiratoryRate Int?
  bodyTemp        Decimal?   @db.Decimal(4, 1)
  weightKg        Decimal?   @db.Decimal(5, 2)
  heightCm        Decimal?   @db.Decimal(5, 2)
  status          NoteStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  medicalRecord MedicalRecord           @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  author        User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  amendments    ClinicalNoteAmendment[]

  @@index([medicalRecordId])
  @@index([authorId])
}

model ClinicalNoteAmendment {
  id             String   @id @default(uuid())
  clinicalNoteId String
  amendedById    String
  reason         String   @db.Text
  previousData   Json
  amendedAt      DateTime @default(now())

  clinicalNote ClinicalNote @relation(fields: [clinicalNoteId], references: [id], onDelete: Cascade)

  @@index([clinicalNoteId])
}

model Diagnosis {
  id              String   @id @default(uuid())
  medicalRecordId String
  icd10Code       String   @db.VarChar(10)
  description     String   @db.VarChar(255)
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
  @@index([icd10Code])
}

model MedicalAction {
  id              String   @id @default(uuid())
  medicalRecordId String
  icd9Code        String?  @db.VarChar(10)
  actionName      String   @db.VarChar(150)
  cost            Decimal  @db.Decimal(12, 2)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
}

// -------------------------------------------------------------
// RAWAT INAP (INPATIENT)
// -------------------------------------------------------------

model Ward {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  classTier String   @db.VarChar(50)
  createdAt DateTime @default(now())

  rooms Room[]
}

model Room {
  id         String   @id @default(uuid())
  wardId     String
  roomNumber String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  ward Ward  @relation(fields: [wardId], references: [id], onDelete: Restrict)
  beds Bed[]

  @@unique([wardId, roomNumber])
  @@index([wardId])
}

model Bed {
  id        String    @id @default(uuid())
  roomId    String
  bedNumber String    @db.VarChar(20)
  dailyRate Decimal   @db.Decimal(12, 2)
  status    BedStatus @default(AVAILABLE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  admissions Admission[]

  @@unique([roomId, bedNumber])
  @@index([status])
}

model Admission {
  id              String          @id @default(uuid())
  admissionNumber String          @unique @db.VarChar(30)
  patientId       String
  bedId           String
  admittedAt      DateTime        @default(now())
  dischargedAt    DateTime?
  status          AdmissionStatus @default(ADMITTED)
  admitDiagnosis  String          @db.Text
  dischargeReason String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  bed          Bed           @relation(fields: [bedId], references: [id], onDelete: Restrict)
  bedTransfers BedTransfer[]

  @@index([patientId])
  @@index([bedId])
  @@index([status])
}

model BedTransfer {
  id            String   @id @default(uuid())
  admissionId   String
  fromBedId     String
  toBedId       String
  transferredAt DateTime @default(now())
  reason        String?  @db.Text

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
}

// -------------------------------------------------------------
// FARMASI & INVENTORY OBAT
// -------------------------------------------------------------

model Medication {
  id           String   @id @default(uuid())
  code         String   @unique @db.VarChar(30)
  name         String   @db.VarChar(150)
  category     String   @db.VarChar(100)
  dosageForm   String   @db.VarChar(50)
  unit         String   @db.VarChar(30)
  minStock     Int      @default(10)
  currentStock Int      @default(0)
  pricePerUnit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batches           MedicationBatch[]
  stockMovements    StockMovement[]
  prescriptionItems PrescriptionItem[]

  @@index([name])
  @@index([category])
}

model MedicationBatch {
  id            String   @id @default(uuid())
  medicationId  String
  batchNumber   String   @db.VarChar(50)
  expiryDate    DateTime @db.Date
  initialQty    Int
  currentQty    Int
  purchasePrice Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@unique([medicationId, batchNumber])
  @@index([expiryDate])
}

model StockMovement {
  id              String            @id @default(uuid())
  medicationId    String
  type            StockMovementType
  quantity        Int
  balanceAfter    Int
  referenceNumber String?           @db.VarChar(50)
  notes           String?           @db.Text
  performedBy     String
  createdAt       DateTime          @default(now())

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@index([medicationId, createdAt])
}

model Prescription {
  id              String             @id @default(uuid())
  rxNumber        String             @unique @db.VarChar(30)
  medicalRecordId String
  status          PrescriptionStatus @default(PENDING)
  dispensedAt     DateTime?
  dispensedBy     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  medicalRecord MedicalRecord      @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  items         PrescriptionItem[]

  @@index([medicalRecordId])
  @@index([status])
}

model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String
  medicationId   String
  dosage         String  @db.VarChar(100)
  quantity       Int
  pricePerUnit   Decimal @db.Decimal(12, 2)
  totalPrice     Decimal @db.Decimal(12, 2)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@index([medicationId])
}

// -------------------------------------------------------------
// LABORATORIUM
// -------------------------------------------------------------

model LabTestType {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(150)
  category  String   @db.VarChar(100)
  refRange  String   @db.VarChar(100)
  unit      String   @db.VarChar(30)
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  labOrderItems LabOrderItem[]
}

model LabOrder {
  id              String         @id @default(uuid())
  orderNumber     String         @unique @db.VarChar(30)
  medicalRecordId String
  status          LabOrderStatus @default(PENDING)
  requestedAt     DateTime       @default(now())
  validatedAt     DateTime?
  validatedBy     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  medicalRecord MedicalRecord  @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  items         LabOrderItem[]

  @@index([medicalRecordId])
  @@index([status])
}

model LabOrderItem {
  id            String  @id @default(uuid())
  labOrderId    String
  labTestTypeId String
  price         Decimal @db.Decimal(12, 2)

  labOrder    LabOrder    @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTestType LabTestType @relation(fields: [labTestTypeId], references: [id], onDelete: Restrict)
  result      LabResult?

  @@unique([labOrderId, labTestTypeId])
  @@index([labOrderId])
}

model LabResult {
  id             String   @id @default(uuid())
  labOrderItemId String   @unique
  resultValue    String   @db.VarChar(100)
  isAbnormal     Boolean  @default(false)
  notes          String?  @db.Text
  testedBy       String
  testedAt       DateTime @default(now())

  labOrderItem LabOrderItem @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// BILLING & PEMBAYARAN
// -------------------------------------------------------------

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @db.VarChar(30)
  patientId       String
  medicalRecordId String?
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus @default(UNPAID)
  dueDate         DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  itemType    String   @db.VarChar(50)
  description String   @db.VarChar(200)
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(uuid())
  receiptNumber String        @unique @db.VarChar(30)
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  cashierId     String
  notes         String?       @db.Text
  paidAt        DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paidAt])
}

// -------------------------------------------------------------
// AUDIT LOG
// -------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(100)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
